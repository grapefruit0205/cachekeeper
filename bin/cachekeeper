#!/bin/sh
# `cachekeeper audit` / `cachekeeper events`. Claude Code puts a plugin's bin/
# directory on the Bash tool's PATH, so this also runs from inside a session.
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
for candidate in python3 python "py -3"; do
  if $candidate -c 'import sys; sys.exit(0 if sys.version_info >= (3, 8) else 1)' >/dev/null 2>&1; then
    PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}" exec $candidate -m cachekeeper.cli "$@"
  fi
done
echo "cachekeeper: Python 3.8 or newer is required" >&2
exit 1
