{
  "description": "cachekeeper: before a /model or picker switch forfeits a warm prompt cache, ask with the size of the loss, then ask whether the next request should run in a subagent on that model; log every switch for `cachekeeper events`; keep a long session's cache warm while its user is away, on by default (CACHEKEEPER_KEEPALIVE=0 turns it off).",
  "hooks": {
    "PreModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"${CLAUDE_PLUGIN_ROOT}/hooks/run\" ]; then sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run\" pre-model-switch; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PostModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"${CLAUDE_PLUGIN_ROOT}/hooks/run\" ]; then sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run\" post-model-switch; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"${CLAUDE_PLUGIN_ROOT}/hooks/run\" ]; then sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run\" user-prompt-submit; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"${CLAUDE_PLUGIN_ROOT}/hooks/run\" ]; then sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run\" stop; fi",
            "asyncRewake": true,
            "rewakeMessage": "cachekeeper:",
            "rewakeSummary": "cachekeeper keep-alive ping",
            "timeout": 3900
          }
        ]
      }
    ]
  }
}
